{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "packages/config/tsconfig/base.json", "packages/config/tsconfig/react-library.json"],
  "globalEnv": [
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TILESERVER_URL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_GEOAPIFY_API_KEY",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
    "NEXT_PUBLIC_PLAUSIBLE_SRC",
    "NEXT_PUBLIC_CF_BEACON_TOKEN"
  ],
  "globalPassThroughEnv": ["GATE_*", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "build/**"]
    },
    "dev": { "cache": false },
    "lint": {},
    "storybook:smoke": { "cache": false },
    "storybook:smoke:pw": { "cache": false }
  }
}
