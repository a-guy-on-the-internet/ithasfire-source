### Repo-specific generated artifacts ###
# Terraform creates local state/cache under .terraform; never commit.
infra/.terraform/
infra/**/.terraform/
**/.terraform/
*.tfstate
*.tfstate.backup
# Binary plan files generated by `terraform plan -out=...`
*.tfplan
tfplan
tfplan-*

# Local temp outputs from scripts/bundles.
tmp-trpc-dist/

# Release keystores (contain signing credentials).
keystores/

# Appium / Detox test screenshots & traces.
**/artifacts/

# Expo iOS pre-built bundles (generated by `expo export`).
**/ios-dist/

# Appium page-source dumps (debug XML snapshots from device).
page-source-*.xml

# Root-level app.json is the Expo duplicate (canonical lives in apps/mobile).
/app.json

