{
  "name": "ithasfire",
  "version": "0.3.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.16.1",
  "devDependencies": {
    "@sentry/cli": "2.58.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "dotenv": "^17.4.2",
    "esbuild": "0.25.12",
    "eslint": "^9.35.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "turbo": "^2.9.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3"
  },
  "workspaces": [
    "packages/adapters",
    "packages/config/*",
    "packages/core",
    "packages/db",
    "packages/schema",
    "packages/service/*",
    "packages/ui",
    "packages/ui-email",
    "packages/ui-native",
    "packages/web-rn-shims",
    "packages/transport/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "cache:prune": "bash scripts/prune-turbo-cache.sh",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "ci:check-test-coverage": "node scripts/ci/check-ci-test-coverage.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:check:self-test": "node scripts/docs-check.mjs --self-test",
    "ui:storybook": "pnpm -F @th/ui storybook",
    "typecheck": "bash scripts/dev/with-gate-lock.sh tsc -p tsconfig.base.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-daemon/packages.tsbuildinfo",
    "typecheck:all": "bash scripts/dev/with-gate-lock.sh node scripts/typecheck-all.mjs",
    "typecheck:api": "bash scripts/dev/with-gate-lock.sh pnpm -F api exec tsc -p tsconfig.json --noEmit",
    "typecheck:web": "bash scripts/dev/with-gate-lock.sh pnpm -F web exec tsc -p tsconfig.json --noEmit",
    "typecheck:jobs": "bash scripts/dev/with-gate-lock.sh pnpm -F jobs exec tsc -p tsconfig.json --noEmit",
    "typecheck:mobile": "bash scripts/dev/with-gate-lock.sh pnpm -F mobile exec tsc -p tsconfig.json --noEmit",
    "typecheck:scanner": "bash scripts/dev/with-gate-lock.sh pnpm -F scanner exec tsc -p tsconfig.json --noEmit",
    "tsc:daemon": "node scripts/tsc-daemon.mjs",
    "tsc:daemon:stop": "node scripts/tsc-daemon.mjs stop",
    "tsc:status": "node scripts/tsc-status.mjs",
    "tsc:status:selftest": "node scripts/tsc-status.mjs --selftest",
    "gate:status": "node scripts/dev/gate/status.mjs",
    "gate:test": "node --test scripts/dev/gate/gate.test.mjs scripts/dev/gate/bypass-guard.test.mjs",
    "api": "pnpm -F api dev",
    "api:bg": "node scripts/start-api-detached.cjs",
    "api:bg:stop": "node scripts/stop-api-detached.cjs",
    "api:bg:status": "node scripts/status-api-detached.cjs",
    "stripe:listen:bg": "node scripts/start-stripe-listen-detached.cjs",
    "stripe:listen:bg:stop": "node scripts/stop-stripe-listen-detached.cjs",
    "stripe:listen:bg:status": "node scripts/status-stripe-listen-detached.cjs",
    "web": "pnpm -F web dev",
    "web:smoke": "pnpm -F web smoke",
    "web:dev:local": "node scripts/run-web-dev.cjs --base http://localhost:3001",
    "stack:dev": "pnpm api:bg && node scripts/run-web-dev.cjs --base http://localhost:3001",
    "db:reset": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public tsx scripts/db-reset.ts",
    "db:reset:remote": "tsx scripts/db-reset.ts",
    "db:wipe": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public tsx scripts/db-wipe.ts",
    "db:wipe:remote": "tsx scripts/db-wipe.ts",
    "tiles:download": "bash scripts/dev/download-tiles.sh",
    "tiles:upload": "bash scripts/dev/sync-tiles-gcs.sh",
    "db:backfill:paidout": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public tsx scripts/backfill-order-item-paidout.ts",
    "db:backfill:paidout:remote": "tsx scripts/backfill-order-item-paidout.ts",
    "human:dev": "node scripts/human-dev.cjs",
    "mobile": "pnpm -F mobile ios",
    "mobile:smoke": "pnpm -F mobile smoke",
    "mobile:lint": "pnpm -F mobile lint",
    "vitest:bg": "node scripts/run-vitest-watch.cjs",
    "vitest:bg:stop": "node scripts/stop-vitest-watch.cjs",
    "scanner": "pnpm -F scanner start",
    "prisma:gen": "pnpm -C packages/db run generate",
    "prisma:push": "pnpm exec prisma db push",
    "db:migrate:dev": "pnpm exec prisma migrate dev",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:migrate:status": "pnpm exec prisma migrate status",
    "db:validate": "pnpm exec prisma validate",
    "infra:test": "bash infra/scripts/validate.sh",
    "seed:dev": "pnpm -F api seed:dev",
    "seed:admin": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-platform-admin.ts",
    "seed:admin:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-platform-admin.ts",
    "seed:categories": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-platform-categories.ts",
    "seed:categories:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-platform-categories.ts",
    "seed:tags": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-platform-tags.ts",
    "seed:tags:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-platform-tags.ts",
    "seed:fee-policy": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-platform-fee-policy.ts",
    "seed:fee-policy:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-platform-fee-policy.ts",
    "seed:volunteer-packs": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-volunteer-packs.ts",
    "seed:volunteer-packs:refresh": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-volunteer-packs.ts --refresh --prune",
    "seed:volunteer-packs:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-volunteer-packs.ts",
    "seed:ticket-packs": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-ticket-packs.ts",
    "seed:ticket-packs:refresh": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-ticket-packs.ts --refresh --prune",
    "seed:ticket-packs:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-ticket-packs.ts",
    "seed:application-form-templates": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-application-form-templates.ts",
    "seed:application-form-templates:refresh": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/reference-data/seed-application-form-templates.ts --refresh --prune",
    "seed:application-form-templates:remote": "pnpm -F api exec tsx src/scripts/reference-data/seed-application-form-templates.ts",
    "seed:community-qa": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/qa/seed-community-suggestions.ts",
    "seed:reviews-qa": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public pnpm -F api exec tsx src/scripts/qa/seed-reviews-qa.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "smoke:pages": "node scripts/dev/gate/run.mjs --weight heavy -- pnpm -F web exec playwright test e2e/page-smoke.spec.ts --project=chromium --reporter=list",
    "preflight": "pnpm typecheck && pnpm lint && pnpm smoke:pages",
    "e2e": "node scripts/dev/gate/run.mjs --weight heavy -- pnpm -F web exec playwright test -c playwright.config.ts",
    "e2e:open": "open apps/web/test-results",
    "email:preview": "pnpm -F @th/ui-email dev",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "pnpm": {
    "overrides": {
      "prisma": "7.1.0",
      "@prisma/client": "7.1.0",
      "react": "19.1.4",
      "react-dom": "19.1.4",
      "react-native": "0.81.6",
      "react-native-reanimated": "~4.1.5",
      "zod": "4.6.5",
      "import-in-the-middle": "3.0.0",
      "csstype": "3.2.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "expo": "~54.0.34",
    "react": "19.1.4",
    "react-native": "0.81.6"
  }
}
