# Copy this file to .env and fill in real values for local development
# Do NOT commit your real secrets to version control.

# Postgres connection (Neon recommended for dev)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Redis connection (Upstash recommended for dev)
REDIS_URL=rediss://YOUR-UPSTASH-HOST:6379

# Default fallback region for local event listings
THC_EVENTS_DEFAULT_REGION_CODE=ca-sf

# Stripe API secret key (use a test key for local development)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# Stripe webhook signing secret (use the webhook secret from Stripe CLI or dashboard)
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Optional: pin API version or point at stripe-mock
STRIPE_API_VERSION=
STRIPE_BASE_URL=

# E2E Stripe mode (sandbox or stub). Defaults to sandbox when unset.
E2E_STRIPE_MODE=

# Optional: connected account ID used by E2E seed routes (acct_...)
E2E_STRIPE_ACCOUNT_ID=

# Better Auth JWT verification (required for authenticated tRPC routes)
BETTER_AUTH_JWKS_URL=https://your-better-auth-host/api/auth/jwks
BETTER_AUTH_ISSUER=https://your-better-auth-host
BETTER_AUTH_AUDIENCE=api

# ─────────────────────────────────────────────────────────────────────────────
# OAuth Social Providers (optional - for social sign-in)
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth - get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Apple Sign In - get from https://developer.apple.com/account/resources
# APPLE_CLIENT_ID is your Services ID (e.g., com.example.app.service)
# APPLE_CLIENT_SECRET is a JWT - generate with: node scripts/generate-apple-client-secret.js
# APPLE_APP_BUNDLE_IDENTIFIER is your iOS app bundle ID (for native Sign in with Apple)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Base URL your app uses for return/redirects (adjust if running on a different port)
APP_BASE_URL=http://localhost:3001

# Support page URL used in transactional emails and receipts.
# Falls back to ${PUBLIC_WEB_URL}/support when unset, but set explicitly to avoid surprises.
SUPPORT_URL=http://localhost:3000/support

# ─────────────────────────────────────────────────────────────────────────────
# Meilisearch (optional - for event search)
# ─────────────────────────────────────────────────────────────────────────────
# Run locally via docker compose: cd infra/docker && docker compose up meilisearch -d
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key

# ─────────────────────────────────────────────────────────────────────────────
# Tileserver (static map images in emails)
# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted tileserver. Run locally via docker compose:
#   cd infra/docker && docker compose up tileserver -d
TILESERVER_URL=http://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# Ziptax (US sales tax rate lookup)
# ─────────────────────────────────────────────────────────────────────────────
# API key from https://zip-tax.com — used for postal-code-based tax lookups.
ZIPTAX_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Content Safety (image moderation — consumed by the JOBS service)
# ─────────────────────────────────────────────────────────────────────────────
# The moderation.drain-image-moderations job scans uploaded images. When BOTH
# the endpoint and key below are set, jobs use the real Azure adapter; when
# either is unset the jobs service falls back to the auto-approving STUB adapter
# (every image is APPROVED) so local/dev flows aren't blocked. Never commit a
# real key. In deployed envs these come from GCP Secret Manager.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# Azure severity (0–7) at/above which an image is FLAGGED (held for review)
# rather than auto-APPROVED. Optional — defaults to 4 ("high") when unset.
IMAGE_MODERATION_REVIEW_THRESHOLD=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (bot protection on public embed checkout)
# ─────────────────────────────────────────────────────────────────────────────
# Server-side secret. When set, the API swaps the always-pass Noop adapter for
# real verification, so create-embed-guest-checkout REQUIRES a Turnstile token.
# Pair with the web site key (NEXT_PUBLIC_TURNSTILE_SITE_KEY in apps/web/.env.local)
# or embed checkout breaks. For local dev use Cloudflare's always-pass TEST secret
# (valid on any hostname): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# NOTE: the matching client-side site key is a WEB var, not an API var — it lives in
# apps/web/.env.local as NEXT_PUBLIC_TURNSTILE_SITE_KEY (local TEST key: 1x00000000000000000000AA).

# ─────────────────────────────────────────────────────────────────────────────
# Jobs service (internal)
# ─────────────────────────────────────────────────────────────────────────────
# URL of the jobs Fastify service. Defaults to http://localhost:3002 when unset.
# JOBS_SERVICE_URL=http://localhost:3002
# Shared Bearer token for authenticating API -> Jobs requests.
# Must match the JOBS_API_KEY set on the jobs service.
# Optional locally — when unset, the jobs service allows unauthenticated access.
# JOBS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# File Storage (S3-compatible: MinIO for local dev, Cloudflare R2 in production)
# ─────────────────────────────────────────────────────────────────────────────
# Local: run `cd infra/docker && docker compose up minio minio-init -d`
# The minio-init container auto-creates the bucket on first start.
# MinIO console: http://localhost:9001 (minioadmin / minioadmin)
S3_BUCKET=th-dev
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/th-dev

# ─────────────────────────────────────────────────────────────────────────────
# Dev/Test: instant settlement payouts
# ─────────────────────────────────────────────────────────────────────────────
# When "true", settlements are scheduled for immediate payout so the
# batch runner picks them up on the next cycle. Ignored in production.
DEV_INSTANT_PAYOUTS=true

# ─────────────────────────────────────────────────────────────────────────────
# Dev only: bypass the staff second-factor requirement
# ─────────────────────────────────────────────────────────────────────────────
# /platform and /moderate require an enrolled second factor, enforced at the
# API boundary (packages/transport/trpc/src/guard.ts), not just by the
# /enroll-2fa redirect. Without a real authenticator on the seeded admin those
# surfaces cannot be opened locally at all.
#
# Set to "true" ONLY in local development. Hard-ignored when
# NODE_ENV=production — the bypass is unreachable on that branch, and setting
# it there logs a [security] error instead. Left OFF here on purpose: copying
# this file should never silently disable 2FA.
#
# See packages/transport/trpc/src/dev-staff-2fa-bypass.ts
DEV_BYPASS_STAFF_2FA=false
