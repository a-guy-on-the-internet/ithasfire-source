{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "bundle": "node ../../scripts/bundle-service.mjs .",
    "start": "node --enable-source-maps dist/bundle/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "smoke": "tsx test/smoke.ts",
    "seed:dev": "tsx src/scripts/seed/seed-data.ts",
    "reindex:search": "tsx src/scripts/ops/reindex-search.ts",
    "backfill:category-slugs": "tsx src/scripts/backfill/backfill-category-slugs.ts",
    "backfill:event-slugs": "tsx src/scripts/backfill/backfill-event-slugs.ts",
    "backfill:event-slug-dates": "tsx src/scripts/backfill/correct-event-slug-dates.ts",
    "backfill:list-staff-places": "tsx src/scripts/backfill/list-staff-created-places.ts",
    "backfill:freeze-deals": "tsx src/scripts/backfill/freeze-published-deals.ts",
    "seed:admin": "tsx src/scripts/reference-data/seed-platform-admin.ts",
    "seed:verification-qa": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public tsx src/scripts/qa/seed-place-verification-qa.ts",
    "seed:invite-pause-qa": "tsx src/scripts/qa/seed-invite-pause-qa.ts",
    "seed:moderation-qa": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public tsx src/scripts/qa/seed-moderation-qa.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.9",
    "@better-auth/prisma-adapter": "1.6.9",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@sentry/node": "^10.46.0",
    "@th/adapters": "workspace:^",
    "@th/core": "workspace:^",
    "@th/db": "workspace:^",
    "@th/errors": "workspace:^",
    "@th/ports": "workspace:^",
    "@th/schema": "workspace:^",
    "@th/trpc": "workspace:^",
    "@th/types": "workspace:^",
    "@trpc/server": "^11.5.1",
    "ajv": "8.20.0",
    "better-auth": "1.6.9",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "google-auth-library": "^10.3.0",
    "html-to-text": "10.0.1",
    "isbot": "^5.1.40",
    "jose": "^6.1.3",
    "stripe": "^18.5.0",
    "superjson": "^2.2.2",
    "svix": "^1.90.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@th/tsconfig": "workspace:^",
    "tsx": "4.23.1",
    "vitest": "^3.2.4"
  }
}
