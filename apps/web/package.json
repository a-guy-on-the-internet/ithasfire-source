{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -F @th/trpc run build && next dev --turbopack",
    "build": "node scripts/with-gate.mjs heavy -- pnpm run build:ungated",
    "build:ungated": "pnpm -F @th/trpc run build && next build --turbopack",
    "smoke": "node scripts/with-gate.mjs heavy -- pnpm run smoke:ungated",
    "smoke:ungated": "pnpm -F @th/trpc run build && cross-env WEB_SMOKE_BUILD=true next build --webpack",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint . && pnpm run lint:css && pnpm run lint:colors",
    "lint:css": "node scripts/lint-css-colors.mjs --selftest && node scripts/lint-css-colors.mjs",
    "lint:colors": "node scripts/lint-color-fallbacks.mjs --selftest && node scripts/lint-color-fallbacks.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:watch": "vitest",
    "test:run": "vitest --run",
    "test:ci": "vitest --run --config vitest.ci.config.ts",
    "test:e2e": "node scripts/with-gate.mjs heavy -- playwright test -c playwright.config.ts",
    "test:e2e:smoke": "node scripts/with-gate.mjs heavy -- playwright test e2e/page-smoke.spec.ts --project=chromium --reporter=list",
    "test:e2e:ui": "playwright test -c playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report",
    "help-drift": "tsx scripts/check-help-drift.ts"
  },
