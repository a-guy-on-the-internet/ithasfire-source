{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*",
    "app/**/*",
    "lib/**/*",
    "components/**/*",
    ".storybook/**/*",
    ".storybook/*",
    "scripts/**/*",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", ".next", "out", "build"]
}
