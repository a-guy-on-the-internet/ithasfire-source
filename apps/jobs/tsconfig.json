{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": false,
    // Incremental so a re-run that follows no source change is near-instant.
    // The build info lives in node_modules/.cache (already gitignored) instead
    // of beside the tsconfig, so it never shows up as untracked.
    //
    // GOTCHA: `tsc --incremental` never stats its own outputs, so deleting
    // `dist/` while this build info survives makes `pnpm build` exit 0 having
    // emitted NOTHING. If you cleaned dist by hand, delete the file below too.
    // Harmless in the deploy path — the Dockerfile discards tsc's output and
    // the image runs the esbuild bundle (`dist/bundle`, written by
    // scripts/bundle-service.mjs, which tsc never touches) — but it will
    // cost you twenty minutes at a terminal.
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsc-daemon/apps-jobs.tsbuildinfo",
    "outDir": "dist",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@th/core/*": ["../../packages/core/src/*"],
      "@th/adapters": ["../../packages/adapters/src/index.ts"],
      "@th/adapters/*": ["../../packages/adapters/src/*"],
      "@th/ports": ["../../packages/ports/src/index.ts"],
      "@th/ports/*": ["../../packages/ports/src/*"],
      "@th/test-utils": ["../../packages/test-utils/src/index.ts"],
      "@th/test-utils/*": ["../../packages/test-utils/src/*"],
      "@th/types": ["../../packages/types/src/index.ts"],
      "@th/types/*": ["../../packages/types/src/*"],
      "@th/schema": ["../../packages/schema/src/index.ts"],
      "@th/schema/*": ["../../packages/schema/src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "../../packages/adapters/src/db/prisma/payouts.ts",
    "../../packages/adapters/src/db/prisma/settlement-lines.ts",
    "../../packages/adapters/src/db/prisma/order-item-settlement-lines.ts"
  ]
}
