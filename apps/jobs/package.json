{
  "name": "jobs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --quiet",
    "bundle": "node ../../scripts/bundle-service.mjs .",
    "start": "node --enable-source-maps dist/bundle/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "validate:manifest": "tsx src/scripts/validate-manifest.ts",
    "generate:registry": "tsx src/scripts/generate-job-registry.ts",
    "check:registry": "tsx src/scripts/generate-job-registry.ts --check",
    "test:payout-notification": "tsx src/scripts/test-payout-notification.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@sentry/node": "^10.46.0",
    "@th/adapters": "workspace:^",
    "@th/ui-email": "workspace:^",
    "@th/core": "workspace:^",
    "@th/db": "workspace:^",
    "@th/errors": "workspace:^",
    "@th/ports": "workspace:^",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "google-auth-library": "^10.3.0",
    "html-to-text": "10.0.1",
    "ioredis": "^5.6.1",
    "luxon": "^3.7.2",
    "pg": "^8.11.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@th/test-utils": "workspace:^",
    "@th/tsconfig": "workspace:^",
    "@types/luxon": "^3.3.3",
    "@types/pg": "^8.11.6",
    "tsx": "4.23.1",
    "vitest": "^3.2.4"
  }
}
