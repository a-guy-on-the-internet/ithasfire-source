{
  "name": "@th/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./colors": {
      "types": "./src/ui/tamagui/tokens/colors.ts",
      "import": "./src/ui/tamagui/tokens/colors.ts",
      "default": "./src/ui/tamagui/tokens/colors.ts"
    },
    "./keyboard": {
      "types": "./src/ui/shell/utils/command-palette-chord.ts",
      "import": "./src/ui/shell/utils/command-palette-chord.ts",
      "default": "./src/ui/shell/utils/command-palette-chord.ts"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@react-native-community/datetimepicker": "^8.5.0",
    "@tamagui/animations-react-native": "^1.138.5",
    "@th/locale": "workspace:^",
    "@th/schema": "workspace:^",
    "@th/types": "workspace:^",
    "libphonenumber-js": "^1.12.33",
    "lucide-react": "^0.548.0",
    "react-native-svg": "^15.13.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "~2.2.12",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-gesture-handler": ">=2.29.1",
    "react-native-reanimated": ">=4.1.5",
    "react-native-web": ">=0.19.0",
    "tamagui": ">=1.138.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-interactions": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@storybook/testing-react": "^2.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@th/tsconfig": "workspace:^",
    "@th/ui-email": "workspace:^",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.1.3",
    "jsdom": "^26.0.0",
    "storybook": "^8.3.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.3"
  },
  "scripts": {
    "prestorybook": "pnpm -F @th/ui-email storybook:samples",
    "prestorybook:build": "pnpm -F @th/ui-email storybook:samples",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:smoke": "node ./scripts/storybook-dev-smoke.mjs",
    "storybook:smoke:pw": "playwright test -c ./playwright.storybook.config.ts",
    "storybook:refresh": "pnpm -F @th/ui-email storybook:samples",
    "lint": "eslint . --quiet",
    "test": "vitest --run"
  }
}
