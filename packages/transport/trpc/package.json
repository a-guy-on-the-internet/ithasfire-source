{
  "name": "@th/trpc",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./client-ip": {
      "types": "./src/client-ip.ts",
      "default": "./src/client-ip.ts"
    },
    "./rate-limit-markers": {
      "types": "./src/rate-limit-markers.ts",
      "default": "./src/rate-limit-markers.ts"
    },
    "./dev-staff-2fa-bypass": {
      "types": "./src/dev-staff-2fa-bypass.ts",
