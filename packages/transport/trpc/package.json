    "@trpc/server": "^11.5.1",
    "google-auth-library": "^10.3.0",
    "superjson": "^2.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@th/tsconfig": "workspace:^",
    "ioredis": "^5.8.0"
  }
