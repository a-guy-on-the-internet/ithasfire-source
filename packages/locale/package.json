{
  "name": "@th/locale",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./messages/*": "./messages/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "vitest --run",
    "lint:messages": "node ./scripts/sort-messages.mjs --check",
    "format:messages": "node ./scripts/sort-messages.mjs",
    "lint:icu": "node ./scripts/lint-icu.mjs"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@th/tsconfig": "workspace:^",
    "@formatjs/icu-messageformat-parser": "^2.7.11",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.3",
    "@formatjs/cli": "^6.3.2"
  }
}
