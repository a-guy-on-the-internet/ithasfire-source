enum PayeeLedgerEntryType {
  SETTLEMENT_CREDIT
  REFUND_DEBIT
  DISPUTE_HOLD
  DISPUTE_DEBIT
  DISPUTE_RELEASE
  PAYOUT
  RESERVE_HOLD
  RESERVE_RELEASE
  MANUAL_ADJUSTMENT
  /// Written when a post-payout refund successfully reverses a Stripe
  /// transfer: the money came back to the platform externally, so the payee's
  /// balance owes nothing net. +effect on `ledgerBalanceCents`;
  /// `relatedEntryId` links to the REFUND_DEBIT it compensates.
  TRANSFER_REVERSAL_CREDIT
  /// A cash sale at the door: the organiser holds the cash, and the platform
  /// fee + tax in it are owed to the platform. −effect on the payable and on
  /// `ledgerBalanceCents`; the next payout is reduced by it, and a cash-only
  /// payee carries the negative balance forward (owner ruling R6, 2026-10-07).
  CASH_SALE_DEBIT
  /// Reverses a CASH_SALE_DEBIT when the cash sale is refunded at the gate.
  /// +effect; `relatedEntryId` links to the debit it reverses.
  CASH_SALE_DEBIT_REVERSAL
}

