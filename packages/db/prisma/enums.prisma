enum VolunteerAskCadence {
  ONE_TIME
  ONGOING
  RECURRING
}

enum VolunteerSignupStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  CHECKED_IN
  NO_SHOW
}

/// Pre-shift reminder dispatch tracking. Two cron windows: 24h ahead
/// (`*/15 * * * *`, fires once per signup in the 23h45m–24h15m band)
/// and 1h ahead (`*/5 * * * *`, 55m–65m band). The reminder dispatcher
/// idempotency table keys on this enum + the channel, so adding a new
/// kind here automatically gets a clean dispatch ledger.
enum VolunteerReminderKind {
  REMINDER_24H
  REMINDER_1H
}

/// When a volunteer comp-ticket reward fires for a signup. Per the
/// 2026-06-29 volunteer-comp-tickets spec (+ 2026-07-01 resolutions):
/// ON_APPROVAL incentivizes commitment, ON_CHECK_IN incentivizes actually
/// showing up — the default and the safer money posture.
enum VolunteerRewardTrigger {
  ON_APPROVAL
  ON_CHECK_IN
}

/// Publication state of a platform-curated VolunteerPack. DRAFT is
/// staff-only — its roles must not appear in ANY organizer-facing response
/// (list, apply, fork); LIVE surfaces them inline in every org's template
/// list. Deliberately just two states: scheduled windows (curatedAt /
/// curatedUntil, as FeaturedItem has) are out of scope.
enum VolunteerPackStatus {
  DRAFT
  LIVE
}

/// Publication state of a platform-curated TicketPack. Mirrors
/// VolunteerPackStatus exactly (and deliberately stays a separate enum so the
/// two catalogues can diverge later without a shared-enum migration): DRAFT
/// is staff-only — its templates must not appear in ANY organizer-facing
/// response (list, apply, fork); LIVE surfaces them inline in every owner's
/// template list.
enum TicketPackStatus {
  DRAFT
  LIVE
}

/// What a VolunteerRoleTemplateShift's start time is measured from.
/// WALL_CLOCK reproduces the pre-2026-07 behaviour exactly: use
/// `startMinuteOfDay` as a time of day and ignore `offsetMinutes`.
/// EVENT_START / EVENT_END resolve against Event.startsAt / Event.endsAt
/// plus the signed `offsetMinutes` (e.g. −180 = "three hours before
/// doors-ish"). `startDayOffset` still applies in all cases. There is no
/// DOORS anchor — Event has no doorsAt column.
enum VolunteerShiftAnchor {
  WALL_CLOCK
  EVENT_START
  EVENT_END
}

/// Lifecycle of one issued reward grant. GRANTED = comp issued and live;
/// REDEEMED = the comp ticket was scanned; REVOKED = voided before
/// redemption (signup WITHDRAWN or manual revoke — nothing else
/// auto-revokes) and the budget slot returned.
enum VolunteerRewardGrantStatus {
  GRANTED
  REDEEMED
  REVOKED
}

/// Lifecycle of a concrete dated volunteer slot on a standing ask
/// (generic-volunteer-shifts-occurrences FR-001). CANCELLED rows are kept
/// (never deleted) so claimants' history and cancellation notifications
/// stay auditable.
enum VolunteerOccurrenceStatus {
  SCHEDULED
  CANCELLED
}

/// Lifecycle of one volunteer's commitment to one occurrence. Withdrawn
/// rows are kept (unique per (occurrence, signup)) and flip back to
/// CLAIMED on a re-claim.
enum VolunteerOccurrenceClaimStatus {
  CLAIMED
  WITHDRAWN
}

/// How a claim came to exist: the volunteer clicked (SELF) or an
/// owner/coordinator placed them (ASSIGNED). Shadow (no-account)
/// volunteers can only ever be ASSIGNED.
enum VolunteerOccurrenceClaimSource {
  SELF
  ASSIGNED
}

