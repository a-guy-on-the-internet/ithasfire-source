// Two-value model (location-visibility-reveal spec, 2026-06-23):
//   EXACT    — full public address + coordinates.
//   OBSCURED — public pre-reveal view is governed by locationRadiusMeters
//              (non-null = deterministic obfuscated circle, null = FULLY HIDDEN
//              with no public map); the exact address is always revealed to
//              ticket holders at the mandatory addressRevealAt.
// Deliberately NOT named "PRIVATE" — that value exists on EventVisibility
// (a different axis: who can find the event vs how exact the location is).
// Legacy APPROXIMATE/HIDDEN were collapsed into OBSCURED
// (migrations 20260707100000 + 20260707100001).
enum EventLocationMode {
  EXACT
  OBSCURED
}

// Reveal schedules for an OBSCURED event's exact address.
//
// Every member except NEVER resolves a NON-NULL `addressRevealAt`. NEVER is
// the one member that deliberately resolves `addressRevealAt = null`, and it
// is what makes a null reveal date READABLE: before it existed, a null on an
// OBSCURED event could only be an invariant violation, so the redactors
// fail-close on it and every reader had to guess whether the row was broken.
// With NEVER stored alongside, `(OBSCURED, preset = NEVER, at = null)` says
// "the organizer chose this" and `(OBSCURED, preset = null, at = null)` still
// says "this row is broken". Both stay LOCKED FOREVER at read time — the
// redaction behaviour is identical, only the intent is now legible.
enum AddressRevealPreset {
  IMMEDIATELY       // addressRevealAt = save time (reveal right away)
  ONE_HOUR_BEFORE   // addressRevealAt = startsAt - 1h
  DAY_BEFORE        // addressRevealAt = startsAt - 24h (default for OBSCURED)
  WEEK_BEFORE       // addressRevealAt = startsAt - 7d
  CUSTOM            // organizer picked a specific datetime
  NEVER             // addressRevealAt = null BY CHOICE — never revealed, to anyone
}

