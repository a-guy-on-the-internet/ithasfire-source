  RETIRED
}

/// Lifecycle of a BookingHold (booking-holds spec 2026-08-25, FR-001).
/// NOT the POS/promo/resale "hold" (short-TTL inventory reservation) — this
/// is a venue calendar hold with a days-long lifecycle.
enum BookingHoldStatus {
  ACTIVE          // in the line for its calendar+date
  CHALLENGED      // staff challenged position 1; act must keep/release by respondBy
  CONFIRMED       // confirmed → draft Event minted; terminal
  RELEASED        // out of the line (see BookingHoldReleaseReason); terminal
}

/// Why a BookingHold left its line. Null while ACTIVE/CHALLENGED/CONFIRMED.
enum BookingHoldReleaseReason {
  MANUAL            // staff released, or the act answered a challenge with "release"
  EXPIRED           // CHALLENGED and respondBy lapsed (FR-007, lazy write-on-read)
  CONFIRMED_OTHER   // another act's hold on the same calendar+date was confirmed
  REQUEST_CLOSED    // the owning request was DECLINED / WITHDRAWN / EXPIRED (FR-009)
  SIBLING_CONFIRMED // another hold on the same request was confirmed (FR-008)
  PAST_DATE         // the date passed without confirmation (FR-010, no notifications)
  EVENT_SCHEDULED   // an event on the same calendar+date became PUBLISHED (FR-018)
  BOOKING_CANCELLED // the booked night was cancelled (booking-the-night FR-009): the ONE path from CONFIRMED to RELEASED
  GRANT_ENDED       // a BOOKER hold whose booking grant was revoked or expired (holds-without-a-request FR-003 / FR-004)
}

/// Whose hold a BookingHold is (holds-without-a-request spec 2026-09-30,
/// rulings H1 / H5 / H6, FR-001). The column shape per kind is a SQL-only
/// CHECK, "BookingHold_owner_kind_shape" (see BookingHold).
enum BookingHoldOwnerKind {
  REQUEST // held for a booking request (every hold before this spec)
  BOOKER  // placed by a booking grantee on its own behalf; carries the grant and exactly one holder
  PLACE   // the place's own hold; optionally names one party (org or person), else unassigned
}

