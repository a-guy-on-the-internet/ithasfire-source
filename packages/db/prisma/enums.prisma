  NETWORK // HMAC of a network prefix the banned human signed in from
}

/// What an API key covers (scoped-api-keys spec 2026-10-08, R1 / R18, "Key
/// scopes" table). A key request and the key collected from it carry exactly
/// one subject. Who may request and who approves differs per subject; that
/// rule lives in core, not here.
enum ApiKeySubject {
  ORG           // one organisation, capped at the holder's live OWNER/ADMIN role there
  PERSONAL      // the holder's own account
  STAFF         // the holder's platform staff surfaces, capped at their live staff role
  PLATFORM_WIDE // public data only: calls run as a signed-out visitor (FR-007); READ only (R19)
}

/// The access level of a key scope (scoped-api-keys spec R3). A mutation
/// needs READ_WRITE; READ reaches only queries.
enum ApiKeyAccess {
  READ
  READ_WRITE
}

/// How a key request was decided (scoped-api-keys spec FR-003 / FR-004).
/// Undecided, withdrawn, lapsed and uncollected are derived from the request's
/// timestamps, never stored.
enum ApiKeyRequestDecision {
  APPROVED
  DENIED // requires a denialReason (SQL-only CHECK on api_key_requests)
}

/// Why a key request was withdrawn (scoped-api-keys spec FR-004, R31).
/// REQUESTER: the requester withdrew a pending request. ACCOUNT_SECURITY: a
/// password reset or a ban closed it (pending or approved-but-uncollected),
/// so the holder is shown why and never reads it as "you withdrew".
enum ApiKeyRequestWithdrawal {
  REQUESTER
  ACCOUNT_SECURITY
}

/// What an arrival area is for (arrival-areas FR-001). LOAD_IN is shown only
