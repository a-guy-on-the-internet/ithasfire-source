  TAGGED          // a platform artist the sender tagged (a human); notified, confirms or declines
  EXTERNAL        // a free-text act with no platform identity
}

/// Consent state of an act on a bill. SELF and EXTERNAL rows are CONFIRMED
/// at insert (SQL CHECK); only TAGGED rows ever sit PENDING.
enum BookingRequestActConfirmation {
