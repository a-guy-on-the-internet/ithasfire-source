// ── Support chat widget ─────────────────────────────────────────────────────
// See docs/specs/2026-06-23/completed/support-chat-widget.spec.yaml. Models live in
// support.prisma. authorType includes AI_CLERK + SYSTEM up front so the AI
// clerk spec (ai-clerk-and-tool-registry) needs no later migration.
// NOTE: enum value *declaration order* is significant. Postgres sorts enum
// columns by declaration order, and the operator inbox relies on that to
// surface escalated threads first (AWAITING_HUMAN, then OPEN, then RESOLVED)
// via a plain `ORDER BY status ASC`. The OPEN default is set explicitly on the
// model and is independent of this ordering.
enum SupportThreadStatus {
  AWAITING_HUMAN // escalated — a human operator needs to reply (inbox top)
  OPEN           // active conversation; AI clerk / self-serve may still suffice
  RESOLVED       // closed out; resolvedAt set
}

enum SupportThreadSource {
  WIDGET // opened from the bottom-right chat widget
  ADMIN  // opened/seeded by an operator
  SYSTEM // opened programmatically (e.g. AI clerk, automation)
}

enum SupportAuthorType {
  USER        // the signed-in attendee
  HUMAN_AGENT // a platform support operator
  AI_CLERK    // the AI clerk (future; thread model is AI-ready)
  SYSTEM      // automated / system-generated message
}

