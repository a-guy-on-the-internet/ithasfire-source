enum ArrivalAreaKind {
  PARKING
  ACCESSIBLE_DROP_OFF
  LOAD_IN
}

/// What parking in an arrival area costs (arrival-areas FR-001). UNKNOWN is
/// the honest default: a manager who has not said is never shown as FREE.
enum ArrivalAreaCost {
  FREE
  PAID
  UNKNOWN
}
