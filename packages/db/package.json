{
  "name": "@th/db",
  "version": "0.0.0",
  "private": true,
  "types": "src/index.ts",
  "type": "module",
  "main": "src/index.ts",
  "devDependencies": {
    "@th/tsconfig": "workspace:^",
    "prisma": "^7.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "generate": "node ../../node_modules/prisma/build/index.js generate --schema=prisma/",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js"
  }
}
