{
  "name": "@th/ui-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./palette": {
      "types": "./src/palette.ts",
      "import": "./src/palette.ts",
      "default": "./src/palette.ts"
    },
    "./theme": {
      "types": "./src/theme.tsx",
      "import": "./src/theme.tsx",
      "default": "./src/theme.tsx"
    },
    "./primitives": {
      "types": "./src/primitives.tsx",
      "import": "./src/primitives.tsx",
      "default": "./src/primitives.tsx"
    },
    "./tone": {
      "types": "./src/tone.ts",
      "import": "./src/tone.ts",
      "default": "./src/tone.ts"
    },
    "./stats-strip-plan": {
      "types": "./src/stats-strip-plan.ts",
      "import": "./src/stats-strip-plan.ts",
      "default": "./src/stats-strip-plan.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --quiet",
    "test": "vitest --run"
  },
  "dependencies": {
    "@th/ui": "workspace:*"
  },
  "peerDependencies": {
    "expo-secure-store": "~15.0.8",
    "lucide-react-native": "^0.548.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "tamagui": ">=1.138.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
