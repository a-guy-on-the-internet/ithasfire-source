#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# pre-commit hook — validates jobs.manifest.json stays in sync with handlers.
#
# Only runs when relevant files are staged. Skip with: git commit --no-verify
# ──────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Secret scan (gitleaks) ────────────────────────────────────────────────────
# Block commits that introduce API keys, tokens, or private keys. Scans only the
# staged diff, so it's fast. Config + allowlist live in .gitleaks.toml.
# Skips with a warning if gitleaks isn't installed (never silently passes on a
# missing tool without telling you). Bypass a false positive with --no-verify.
if command -v gitleaks >/dev/null 2>&1; then
  printf '\033[1;33m▸ Scanning staged changes for secrets…\033[0m\n'
  if gitleaks git --staged --redact --no-banner -c "$REPO_ROOT/.gitleaks.toml" "$REPO_ROOT"; then
    printf '\033[0;32m  ✓ no secrets in staged changes\033[0m\n'
  else
    printf '\033[0;31m  ✗ potential secret detected in staged changes (see above).\033[0m\n'
    printf '\033[0;31m    Remove it, or if it is a false positive add it to .gitleaks.toml.\033[0m\n'
    printf '\033[0;31m    To bypass this one commit: git commit --no-verify\033[0m\n'
    exit 1
  fi
else
  printf '\033[1;33m▸ gitleaks not installed — skipping secret scan. Install: brew install gitleaks\033[0m\n'
fi

# Only check if the manifest, a job handler, the validator itself, an
# environment's tfvars, or the core payout-cycle constant is staged.
#
# The tfvars trigger is the Terraform override drift gate
# (validate-manifest.ts section 5): a new `jobs_scheduler_overrides` entry is a
# tfvars-ONLY commit, and until 2026-09-15 that commit skipped the one check
# written to catch it.
#
# The packages/core trigger is section 6, and it is here for the same reason
# read the other way round: that gate compares the manifest's
# `settlements.run-batch` cron against a constant in core, so the drift can be
# introduced from EITHER side. Edit the manifest and the first pattern catches
# it; edit the constant alone and nothing under apps/jobs is staged at all.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

NEEDS_CHECK=false
if echo "$STAGED" | grep -qE '^apps/jobs/(jobs\.manifest\.json|src/jobs/|src/scripts/(validate-manifest|scheduler-overrides)\.ts$)|^infra/terraform/envs/[^/]+/[^/]+\.tfvars$|^packages/core/src/use-cases/payouts/_shared/payout-batch-cycle\.ts$'; then
  NEEDS_CHECK=true
fi

if [ "$NEEDS_CHECK" = false ]; then
  exit 0
fi

printf '\033[1;33m▸ Validating jobs manifest…\033[0m\n'

if pnpm -C "$REPO_ROOT/apps/jobs" validate:manifest; then
  printf '\033[0;32m  ✓ jobs.manifest.json in sync\033[0m\n'
else
  printf '\033[0;31m  ✗ jobs.manifest.json out of sync — see errors above\033[0m\n'
  exit 1
fi

# The job registry serves GET /jobs from a GENERATED metadata table
# (apps/jobs/src/jobs/registry.generated.ts) so booting the dispatcher does not
# import 25 handler graphs. Forgetting to regenerate ships a stale description
# or, worse, a stale cron. Regenerate and fail if the result differs from what
# is committed.
printf '\033[1;33m▸ Checking generated job registry…\033[0m\n'

if pnpm -C "$REPO_ROOT/apps/jobs" check:registry; then
  printf '\033[0;32m  ✓ job registry up to date\033[0m\n'
else
  printf '\033[0;31m  ✗ run: pnpm -C apps/jobs generate:registry, then stage the result\033[0m\n'
  exit 1
fi
