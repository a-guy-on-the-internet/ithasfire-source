# Local infra environment example
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dev
MEILI_MASTER_KEY=dev-master-key
MEILISEARCH_PORT=7700

# Tileserver
# Place a .pmtiles file at infra/docker/tileserver/data/openmaptiles.pmtiles
# (run: pnpm tiles:download)
TILESERVER_PORT=8081
# Headless X display for static map rendering. Must be ":<n>" — anything else is
# rejected and falls back to :99. Rarely needs changing.
XVFB_DISPLAY=:99

# MinIO (S3-compatible object storage for local dev)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=th-dev
