# Copy to `infra/.env.local` (gitignored) and fill in real values.
#
# IMPORTANT
# - Do not commit this file once copied.
# - Prefer short-lived credentials (AWS SSO / GCP ADC impersonation) over long-lived keys.

### Local docker-compose stack (infra/docker/)
# Used by `infra/docker/docker-compose*.yml`.
export POSTGRES_USER=postgres
export POSTGRES_PASSWORD=postgres
export POSTGRES_DB=dev

# Optionally set a redis password for local dev
export REDIS_PASSWORD=

### GCP / Terraform backend (recommended)
# If you want to keep impersonation explicit for local commands, set:
# export CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT="hf-sa-281@natural-choir-491400-b7.iam.gserviceaccount.com"

### AWS (preferred: use SSO profile)
export AWS_PROFILE="terraform-dev"
export AWS_REGION="us-east-1"

# If you can't use SSO and must use access keys locally, set these instead:
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."
# export AWS_SESSION_TOKEN="..."  # only if using temporary session creds

### Terraform vars (preferred: use TF_VAR_* so `terraform plan/apply` just works)
# Cloudflare
# IMPORTANT: only needed if you set `enable_cloudflare_dns = true` (in tfvars or TF_VAR_enable_cloudflare_dns).
# export TF_VAR_enable_cloudflare_dns=true
export TF_VAR_cloudflare_zone_id=""
export TF_VAR_cloudflare_account_id=""   # optional unless creating zones (we usually avoid that)
export TF_VAR_cloudflare_api_token=""    # token should have Zone.DNS.Edit (+ optionally Zone.Zone.Read)
# If you prefer the global API key flow, set the two variables below instead of cloudflare_api_token.
export TF_VAR_cloudflare_api_key=""
export TF_VAR_cloudflare_email=""

# Upstash (Terraform)
export TF_VAR_upstash_email=""
export TF_VAR_upstash_api_key=""

# Neon (Terraform)
export TF_VAR_neon_api_key=""

### App/dev convenience (not used by Terraform)
export UPSTASH_REDIS_REST_URL=""
export UPSTASH_REDIS_REST_TOKEN=""

# Public Geoapify key used by the web client for geocoding
export NEXT_PUBLIC_GEOAPIFY_API_KEY=""
# Self-hosted TileServer GL URL (set by Terraform in deployed envs)
export NEXT_PUBLIC_TILESERVER_URL=""
