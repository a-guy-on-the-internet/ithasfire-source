# Local infra env example for tileserver + geocoding
TILESERVER_URL=http://localhost:8081
TILESERVER_PORT=8081

# Valhalla: self-hosted routing engine for A→B travel time
# Start with: cd infra/docker && docker compose up valhalla -d
VALHALLA_URL=http://localhost:8002
ENABLE_TRAVEL_TIME=true

# Geocoding: use Geoapify key (recommended cheapest hosted option)
# Sign up for Geoapify and set this key in your environment or secrets manager
GEOAPIFY_API_KEY=
