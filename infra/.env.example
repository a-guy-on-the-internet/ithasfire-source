# Docker-compose (local only) example.
#
# This file is ONLY for the local Docker stack under `infra/docker/docker-compose*.yml`.
# It is intentionally NOT used by `direnv`/Terraform (see `.envrc` → `.env.local`).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dev

# Optionally set a redis password for local dev
REDIS_PASSWORD=
