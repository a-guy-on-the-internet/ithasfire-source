# ─────────────────────────────────────────────────────────────────────────────
# Secret Manager wiring for Cloud Run services
#
# Sensitive env vars (DB URLs, API keys, signing secrets, OAuth client secrets)
# are stored in Secret Manager and injected into Cloud Run via
# `value_source.secret_key_ref`, instead of as plaintext env vars on the
# service spec. This avoids exposing credentials to anyone with `run.viewer`.
#
# Non-secret values (URLs, public client IDs, feature flags) continue to be
# passed as plain env via the existing `env` parameter on each module.
# ─────────────────────────────────────────────────────────────────────────────

locals {
  # If BETTER_AUTH_SECRET is unset OR still the placeholder string from the
  # .env.example template, generate a real value. We do NOT rotate an
  # already-real value — only override the placeholder.
  better_auth_secret_is_placeholder = (
    var.better_auth_secret == null ||
    var.better_auth_secret == "" ||
    var.better_auth_secret == "dev-secret-please-rotate-32-chars!!"
  )
}

resource "random_password" "better_auth_secret" {
  count   = local.better_auth_secret_is_placeholder ? 1 : 0
  length  = 48
  special = false
}

locals {
  resolved_better_auth_secret = (
    local.better_auth_secret_is_placeholder
    ? random_password.better_auth_secret[0].result
    : var.better_auth_secret
  )

  # Static keyset — Terraform requires for_each keys to be known at plan time.
  # We derive the keyset from enable_* flags and pure-variable presence
  # (NOT from module outputs, which may be apply-time computed).
  # `nonsensitive()` is used around presence checks because the underlying
  # vars are marked sensitive and that propagates into the for_each keys
  # otherwise. We only check "is this value set" — never expose the value.
  app_secret_keys = compact([
    var.enable_neon ? "DATABASE_URL" : "",
    var.enable_neon ? "DIRECT_DATABASE_URL" : "",
    (var.enable_upstash || nonsensitive(var.redis_url != null && var.redis_url != "")) ? "REDIS_URL" : "",
    var.enable_meilisearch ? "MEILISEARCH_API_KEY" : "",
    # AWS keys are generated by the aws_hf_api module (SMS to phone numbers
    # plus opt-out reads; publishing to any topic is denied).
    # Code path: SnsSmsAdapter (apps/api/src/auth/deps.ts) initializes only
    # when both keys are present in env → injected as secret_key_refs below.
    var.enable_aws ? "AWS_ACCESS_KEY_ID" : "",
    var.enable_aws ? "AWS_SECRET_ACCESS_KEY" : "",
    nonsensitive(var.stripe_secret_key != null && var.stripe_secret_key != "") ? "STRIPE_SECRET_KEY" : "",
    nonsensitive(var.stripe_webhook_secret != null && var.stripe_webhook_secret != "") ? "STRIPE_WEBHOOK_SECRET" : "",
    nonsensitive(var.stripe_connect_webhook_secret != null && var.stripe_connect_webhook_secret != "") ? "STRIPE_CONNECT_WEBHOOK_SECRET" : "",
    "BETTER_AUTH_SECRET", # always present — generated if absent
    nonsensitive(var.consent_ip_hash_salt != null && var.consent_ip_hash_salt != "") ? "CONSENT_IP_HASH_SALT" : "",
    # Google + Apple client secrets — gate on var.* (the module's
    # resolved_google_client_secret falls back to var.google_client_secret).
    (var.enable_google_oauth || nonsensitive(var.google_client_secret != null && var.google_client_secret != "")) ? "GOOGLE_CLIENT_SECRET" : "",
    nonsensitive(var.apple_client_secret != null && var.apple_client_secret != "") ? "APPLE_CLIENT_SECRET" : "",
    nonsensitive(var.resend_api_key != null && var.resend_api_key != "") ? "RESEND_API_KEY" : "",
    nonsensitive(var.resend_webhook_secret != null && var.resend_webhook_secret != "") ? "RESEND_WEBHOOK_SECRET" : "",
    nonsensitive(var.discord_alerts_webhook != null && var.discord_alerts_webhook != "") ? "DISCORD_ALERTS_WEBHOOK" : "",
    nonsensitive(var.discord_support_webhook != null && var.discord_support_webhook != "") ? "DISCORD_SUPPORT_WEBHOOK" : "",
    nonsensitive(var.unsubscribe_secret != null && var.unsubscribe_secret != "") ? "UNSUBSCRIBE_SECRET" : "",
    nonsensitive(var.jobs_api_key != null && var.jobs_api_key != "") ? "JOBS_API_KEY" : "",
    nonsensitive(var.turnstile_secret_key != null && var.turnstile_secret_key != "") ? "TURNSTILE_SECRET_KEY" : "",
    nonsensitive(var.origin_shared_secret != null && var.origin_shared_secret != "") ? "ORIGIN_SHARED_SECRET" : "",
    nonsensitive(var.ziptax_api_key != null && var.ziptax_api_key != "") ? "ZIPTAX_API_KEY" : "",
    nonsensitive(var.spotify_client_secret != null && var.spotify_client_secret != "") ? "SPOTIFY_CLIENT_SECRET" : "",
    nonsensitive(var.volunteer_scan_token_secret != null && var.volunteer_scan_token_secret != "") ? "VOLUNTEER_SCAN_TOKEN_SECRET" : "",
    nonsensitive(var.apple_pass_certificate_p12_base64 != null && var.apple_pass_certificate_p12_base64 != "") ? "APPLE_PASS_CERTIFICATE_P12_BASE64" : "",
    nonsensitive(var.apple_pass_certificate_password != null && var.apple_pass_certificate_password != "") ? "APPLE_PASS_CERTIFICATE_PASSWORD" : "",
    # R2 / S3-compatible storage credentials. Were previously inlined as plaintext
    # env vars on jobs + audio-transcoder, readable by anyone with run.viewer.
    nonsensitive(var.storage_s3_access_key_id != null && var.storage_s3_access_key_id != "") ? "S3_ACCESS_KEY_ID" : "",
    nonsensitive(var.storage_s3_secret_access_key != null && var.storage_s3_secret_access_key != "") ? "S3_SECRET_ACCESS_KEY" : "",
    # Azure AI Content Safety (image moderation) — consumed only by the jobs
    # service's drain-image-moderations worker. Held in Secret Manager (endpoint
    # + key both, NFR-004 — no key in git ever). When either is absent the jobs
    # service falls back to the auto-approving stub adapter.
    nonsensitive(var.azure_content_safety_endpoint != null && var.azure_content_safety_endpoint != "") ? "AZURE_CONTENT_SAFETY_ENDPOINT" : "",
    nonsensitive(var.azure_content_safety_key != null && var.azure_content_safety_key != "") ? "AZURE_CONTENT_SAFETY_KEY" : "",
  ])

  app_secret_keyset = toset(local.app_secret_keys)

  # Presence check for the prod guard below. Kept as a local (not inlined into
  # the precondition) so `nonsensitive()` is applied exactly once.
  has_stripe_connect_webhook_secret = nonsensitive(
    var.stripe_connect_webhook_secret != null && var.stripe_connect_webhook_secret != ""
  )

  # Same presence-check shape for the Sentry DSN. See the prod guard below.
  has_sentry_dsn = nonsensitive(
    var.sentry_dsn != null && var.sentry_dsn != ""
  )

  # Value lookup — only referenced for keys in app_secret_keys.
  # Apply-time-unknown values (module outputs) are fine here since we never
  # iterate this map directly — we only do `value_lookup[each.key]`.
  app_secret_value_lookup = {
    DATABASE_URL        = try(module.environment.neon_pooler_connection_uri, null)
    DIRECT_DATABASE_URL = try(module.environment.neon_connection_uri, null)
    # Prefer pre-provisioned URL (prod, enable_upstash=false) over module output (dev).
    REDIS_URL                         = coalesce(var.redis_url, try(module.environment.redis_url, null))
    MEILISEARCH_API_KEY               = local.meilisearch_master_key
    AWS_ACCESS_KEY_ID                 = try(module.environment.aws_api_access_key_id, null)
    AWS_SECRET_ACCESS_KEY             = try(module.environment.aws_api_secret_access_key, null)
    STRIPE_SECRET_KEY                 = var.stripe_secret_key
    STRIPE_WEBHOOK_SECRET             = var.stripe_webhook_secret
    STRIPE_CONNECT_WEBHOOK_SECRET     = var.stripe_connect_webhook_secret
    BETTER_AUTH_SECRET                = local.resolved_better_auth_secret
    CONSENT_IP_HASH_SALT              = var.consent_ip_hash_salt
    GOOGLE_CLIENT_SECRET              = local.resolved_google_client_secret
    APPLE_CLIENT_SECRET               = var.apple_client_secret
    RESEND_API_KEY                    = var.resend_api_key
    RESEND_WEBHOOK_SECRET             = var.resend_webhook_secret
    DISCORD_ALERTS_WEBHOOK            = var.discord_alerts_webhook
    DISCORD_SUPPORT_WEBHOOK           = var.discord_support_webhook
    UNSUBSCRIBE_SECRET                = var.unsubscribe_secret
    JOBS_API_KEY                      = var.jobs_api_key
    TURNSTILE_SECRET_KEY              = var.turnstile_secret_key
    ORIGIN_SHARED_SECRET              = var.origin_shared_secret
    ZIPTAX_API_KEY                    = var.ziptax_api_key
    SPOTIFY_CLIENT_SECRET             = var.spotify_client_secret
    VOLUNTEER_SCAN_TOKEN_SECRET       = var.volunteer_scan_token_secret
    APPLE_PASS_CERTIFICATE_P12_BASE64 = var.apple_pass_certificate_p12_base64
    APPLE_PASS_CERTIFICATE_PASSWORD   = var.apple_pass_certificate_password
    S3_ACCESS_KEY_ID                  = var.storage_s3_access_key_id
    S3_SECRET_ACCESS_KEY              = var.storage_s3_secret_access_key
    AZURE_CONTENT_SAFETY_ENDPOINT     = var.azure_content_safety_endpoint
    AZURE_CONTENT_SAFETY_KEY          = var.azure_content_safety_key
  }

  # Stable secret_id per env. Static — derived from static keys.
  app_secret_id = {
    for k in local.app_secret_keys :
    k => "hf-${local.workspace_environment}-${replace(lower(k), "_", "-")}"
  }

  # Which services consume which secrets.
  api_secrets = [
    "DATABASE_URL", "DIRECT_DATABASE_URL", "REDIS_URL",
    "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "STRIPE_CONNECT_WEBHOOK_SECRET",
    "BETTER_AUTH_SECRET", "CONSENT_IP_HASH_SALT",
    "GOOGLE_CLIENT_SECRET", "APPLE_CLIENT_SECRET",
    "RESEND_API_KEY", "RESEND_WEBHOOK_SECRET", "DISCORD_ALERTS_WEBHOOK",
    "DISCORD_SUPPORT_WEBHOOK",
    "UNSUBSCRIBE_SECRET", "JOBS_API_KEY",
    "TURNSTILE_SECRET_KEY", "ZIPTAX_API_KEY",
    "SPOTIFY_CLIENT_SECRET",
    "VOLUNTEER_SCAN_TOKEN_SECRET",
    # Origin-secret guard — see apps/api/src/plugins/origin-guard.ts.
    "ORIGIN_SHARED_SECRET",
    "APPLE_PASS_CERTIFICATE_P12_BASE64", "APPLE_PASS_CERTIFICATE_PASSWORD",
    # SNS SMS — API sends 2FA OTPs via SnsSmsAdapter.
    "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY",
    # R2 / S3-compatible storage — API presigns uploads (event images/audio,
    # avatars, banners, place layouts, verification docs). Without these the
    # API falls back to NoopFileStorage and every upload throws
    # file_storage_not_configured.
    "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY",
  ]

  jobs_secrets = [
    "DATABASE_URL", "DIRECT_DATABASE_URL", "REDIS_URL",
    "STRIPE_SECRET_KEY",
    "RESEND_API_KEY", "DISCORD_ALERTS_WEBHOOK",
    "JOBS_API_KEY", "UNSUBSCRIBE_SECRET",
    # SNS SMS — jobs dispatches volunteer shift reminders.
    "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY",
    # R2 / S3-compatible storage.
    "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY",
    # Azure AI Content Safety — image-moderation drain worker (jobs only).
    "AZURE_CONTENT_SAFETY_ENDPOINT", "AZURE_CONTENT_SAFETY_KEY",
    # ZipTax — memberships.refresh-tax-jurisdictions re-confirms cached
    # destination-sourced membership tax rates. Without this the job SKIPS
    # every run, and stale rates bill on indefinitely.
    "ZIPTAX_API_KEY",
  ]

  # Origin-secret guard (middleware.ts) needs the same shared secret as the API.
  web_secrets = ["BETTER_AUTH_SECRET", "ORIGIN_SHARED_SECRET"]

  # Audio transcoder reads source files + writes HLS output to the same R2
  # bucket as jobs (or an override bucket, but creds are shared via fallback).
  audio_transcoder_secrets = [
    "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY",
  ]

  # Materialized secret_env maps per service. Empty when the corresponding
  # secret isn't present in this environment (e.g. STRIPE_CONNECT_WEBHOOK_SECRET
  # may be unset in dev).
  api_secret_env = {
    for k in local.api_secrets : k => {
      secret = google_secret_manager_secret.app[k].secret_id
    } if contains(local.app_secret_keys, k)
  }

  jobs_secret_env = {
    for k in local.jobs_secrets : k => {
      secret = google_secret_manager_secret.app[k].secret_id
    } if contains(local.app_secret_keys, k)
  }

  web_secret_env = {
    for k in local.web_secrets : k => {
      secret = google_secret_manager_secret.app[k].secret_id
    } if contains(local.app_secret_keys, k)
  }

  audio_transcoder_secret_env = {
    for k in local.audio_transcoder_secrets : k => {
      secret = google_secret_manager_secret.app[k].secret_id
    } if contains(local.app_secret_keys, k)
  }
}

# ─── Secret + initial version ────────────────────────────────────────────────

resource "google_secret_manager_secret" "app" {
  for_each = local.app_secret_id

  project   = var.project_id
  secret_id = each.value

  replication {
    auto {}
  }

  labels = {
    application = "ithasfire"
    environment = local.workspace_environment
    managed-by  = "terraform"
  }
}

resource "google_secret_manager_secret_version" "app" {
  # Keys come from app_secret_id (non-sensitive), values are looked up by key
  # so Terraform doesn't reject sensitive values inside for_each.
  #
  # APPLE_CLIENT_SECRET is deliberately EXCLUDED here: its value is a short-lived
  # Apple Sign In client-secret JWT that is rotated monthly, out-of-band, by
  # .github/workflows/rotate-apple-secret.yml. Terraform still owns the secret
  # CONTAINER (google_secret_manager_secret.app["APPLE_CLIENT_SECRET"]), but the
  # VALUE is carved out into a dedicated resource below with ignore_changes so
  # `apply` never clobbers a freshly-rotated JWT. See that resource + the moved
  # block for the state migration.
  for_each = { for k, v in local.app_secret_id : k => v if k != "APPLE_CLIENT_SECRET" }

  secret      = google_secret_manager_secret.app[each.key].id
  secret_data = local.app_secret_value_lookup[each.key]

  # Without this, value rotations destroy v(N) before creating v(N+1). If the
  # apply aborts between those steps (e.g. a Cloud Run revision validates
  # secret refs in parallel and fails), `versions/latest` is left pointing at
  # the destroyed v(N) — no live version exists, every subsequent revision
  # roll fails, and the secret has to be healed manually. Creating the new
  # version first means latest always resolves to a live version.
  lifecycle {
    create_before_destroy = true
  }
}

# ─── APPLE_CLIENT_SECRET value: seeded by Terraform, owned by rotation ────────
#
# Split from the shared version resource above so the container stays
# Terraform-managed while the VALUE is owned by the monthly rotation workflow
# (.github/workflows/rotate-apple-secret.yml). This resource seeds an initial
# version when none exists (var.apple_client_secret / TF_VAR_APPLE_CLIENT_SECRET),
# but ignore_changes on secret_data means `apply` never re-asserts that static
# value over the fresher JWTs the workflow writes. Gated on presence of the key
# so envs without the secret configured don't try to create a version against a
# non-existent container.
resource "google_secret_manager_secret_version" "apple_client_secret" {
  count = contains(local.app_secret_keys, "APPLE_CLIENT_SECRET") ? 1 : 0

  secret      = google_secret_manager_secret.app["APPLE_CLIENT_SECRET"].id
  secret_data = local.app_secret_value_lookup["APPLE_CLIENT_SECRET"]

  lifecycle {
    # create_before_destroy: same rationale as the shared resource — never leave
    # `versions/latest` pointing at a destroyed version mid-apply.
    create_before_destroy = true
    # ignore_changes: the value is owned by the rotation workflow; seed once,
    # then never revert a rotated JWT back to the static var on subsequent applies.
    ignore_changes = [secret_data]
  }
}

# Migrate the existing state entry (previously under the shared for_each) to the
# dedicated resource so the next apply neither destroys the live version nor
# creates a spurious duplicate. Carves APPLE_CLIENT_SECRET's value out of the
# shared version resource; see the resource comment above for the why.
moved {
  from = google_secret_manager_secret_version.app["APPLE_CLIENT_SECRET"]
  to   = google_secret_manager_secret_version.apple_client_secret[0]
}

# ─── IAM: grant each runtime SA accessor on the secrets it consumes ──────────

# ─── Predicted runtime SA emails ─────────────────────────────────────────────
# Predicting the email lets us declare the IAM binding without making it
# depend on the Cloud Run module's output. That dependency would create a
# cycle (module → secret_env → secret → IAM → module's SA email), AND it
# would race the Cloud Run service update against IAM propagation. By
# predicting + adding a time_sleep, the binding is in place and propagated
# *before* the module re-applies the service template that references the
# secret_key_ref.
locals {
  predicted_api_runtime_sa  = "hf-${local.workspace_environment}-api-runtime@${var.project_id}.iam.gserviceaccount.com"
  predicted_web_runtime_sa  = "hf-${local.workspace_environment}-web-runtime@${var.project_id}.iam.gserviceaccount.com"
  predicted_jobs_runtime_sa = "hf-${local.workspace_environment}-${var.jobs_service_name}-runtime@${var.project_id}.iam.gserviceaccount.com"
  # NOTE: the audio transcoder runtime SA is NOT predicted here — it is created
  # at root (google_service_account.audio_transcoder_runtime in main.tf) and the
  # audio_transcoder_runtime binding below references its real .email so the
  # binding waits for the SA to exist on a fresh apply.
}

resource "google_secret_manager_secret_iam_member" "api_runtime" {
  for_each = var.api_image == null ? toset([]) : toset([
    for k in local.api_secrets : k if contains(local.app_secret_keys, k)
  ])

  project   = var.project_id
  secret_id = google_secret_manager_secret.app[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${local.predicted_api_runtime_sa}"
}

resource "google_secret_manager_secret_iam_member" "jobs_runtime" {
  for_each = var.jobs_image == null ? toset([]) : toset([
    for k in local.jobs_secrets : k if contains(local.app_secret_keys, k)
  ])

  project   = var.project_id
  secret_id = google_secret_manager_secret.app[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${local.predicted_jobs_runtime_sa}"
}

resource "google_secret_manager_secret_iam_member" "web_runtime" {
  for_each = var.web_image == null ? toset([]) : toset([
    for k in local.web_secrets : k if contains(local.app_secret_keys, k)
  ])

  project   = var.project_id
  secret_id = google_secret_manager_secret.app[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${local.predicted_web_runtime_sa}"
}

resource "google_secret_manager_secret_iam_member" "audio_transcoder_runtime" {
  for_each = var.audio_transcoder_image == null ? toset([]) : toset([
    for k in local.audio_transcoder_secrets : k if contains(local.app_secret_keys, k)
  ])

  project   = var.project_id
  secret_id = google_secret_manager_secret.app[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  # Bind against the root-created runtime SA (see google_service_account
  # .audio_transcoder_runtime in main.tf). Creating the SA at root — rather
  # than inside module.audio_transcoder — lets this binding depend on the real
  # SA without pulling the whole module into the dependency graph, which would
  # cycle once the module also has to wait on time_sleep below.
  member = "serviceAccount:${google_service_account.audio_transcoder_runtime[0].email}"
}

# Wait for IAM bindings to propagate before any Cloud Run service template
# update can validate secret_key_ref entries. Cloud Run checks IAM at
# service-update time; without this wait we hit Error code 9 "Permission
# denied on secret" because the binding was created seconds earlier and
# GCP's IAM cache hadn't refreshed.
resource "time_sleep" "wait_for_secret_iam" {
  depends_on = [
    google_secret_manager_secret_iam_member.api_runtime,
    google_secret_manager_secret_iam_member.jobs_runtime,
    google_secret_manager_secret_iam_member.web_runtime,
    google_secret_manager_secret_iam_member.audio_transcoder_runtime,
  ]
  create_duration = "30s"
}

# ── Guard: the Connect webhook secret must exist in prod ─────────────────────
#
# Without this, an empty `TF_VAR_stripe_connect_webhook_secret` (which is what
# an unset CI secret expands to) is completely invisible: `app_secret_keys`
# drops the key, Terraform plans and applies cleanly, and Cloud Run runs an API
# with no `STRIPE_CONNECT_WEBHOOK_SECRET`. Every connected-account delivery then
# fails signature verification and 400s. Since `account.updated` is the only
# writer of `Payee.payoutsEnabled = true`, payout capability state goes
# permanently stale and organizers cannot publish paid events — while their
# Payments page, which reads live Stripe, shows green.
#
# `terraform_data` + `lifecycle.precondition` fails the apply (a `check` block
# would only warn, which is the failure mode we are removing).
resource "terraform_data" "require_stripe_connect_webhook_secret" {
  count = var.environment == "prod" ? 1 : 0

  input = local.has_stripe_connect_webhook_secret

  lifecycle {
    precondition {
      condition     = local.has_stripe_connect_webhook_secret
      error_message = "stripe_connect_webhook_secret is required when environment = \"prod\". Set the STRIPE_CONNECT_WEBHOOK_SECRET_PROD CI secret to the signing secret of the Stripe webhook endpoint that has \"Listen to events on Connected accounts\" enabled. Without it every account.updated is dropped and orgs cannot publish paid events."
    }
  }
}

# Sentry DSN — same class of silent failure, and it already happened.
#
# `main.tf` injects SENTRY_DSN only when var.sentry_dsn is non-empty, and OMITS
# the env var entirely otherwise. `Sentry.init()` then no-ops, so the API, jobs
# and web services report NOTHING — no spans and no errors — while Terraform
# plans and applies cleanly and every service stays green.
#
# That is not hypothetical. Between 2026-08-31 18:47Z and 2026-09-05 production
# was completely dark in Sentry for five days. The cause was a GitHub
# ENVIRONMENT-scoped `TF_VAR_SENTRY_DSN` on the `prod` environment (environment
# secrets shadow repo secrets) holding an empty value. A *successful* apply on
# 09-03 silently reasserted the gap. Nothing alerted, because the thing that
# would have alerted is the thing that was broken — you cannot page on Sentry
# being down using Sentry.
#
# `terraform_data` + `lifecycle.precondition` fails the apply (a `check` block
# would only warn, which is the failure mode we are removing).
resource "terraform_data" "require_sentry_dsn" {
  count = var.environment == "prod" ? 1 : 0

  input = local.has_sentry_dsn

  lifecycle {
    precondition {
      condition     = local.has_sentry_dsn
      error_message = "sentry_dsn is required when environment = \"prod\". Set TF_VAR_SENTRY_DSN — and check the ENVIRONMENT-scoped secret on the `prod` GitHub environment, which shadows the repo-level secret of the same name (gh api repos/<owner>/<repo>/environments/prod/secrets). Without it Sentry.init() no-ops and production reports no spans and no errors at all."
    }
  }
}
